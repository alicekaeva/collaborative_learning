# Это окружение только для демонстрации и дебага - все значения являются заглушками.
# Этот файл намеренно добавлен для того, чтобы проект можно было запустить сразу после установки.
# Для реального развертывания переопределите эти параметры с помощью .env.local или реальных переменных/секретов окружения.

SECRET_KEY=super-secret-key-change-me-in-production-must-be-32-chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=cluser
POSTGRES_PASSWORD=clpassword
POSTGRES_DB=collaborative_learning

REDIS_URL=redis://:redispassword@redis:6379/0
REDIS_PASSWORD=redispassword

UPLOAD_DIR=/app/uploads/materials
MAX_FILE_SIZE_MB=50

ALLOWED_ORIGINS=["http://localhost:8000","http://localhost:3000"]
COOKIE_SECURE=false
